# Copiar como .env y completar. El archivo .env nunca se sube al repositorio.

# ---- Canal (telegram ahora; whatsapp cuando haya número) ----
CANAL=telegram
TELEGRAM_TOKEN=

# ---- IA (gemini para pruebas; claude en producción) ----
IA_PROVEEDOR=gemini
IA_MODELO=gemini-3.5-flash-lite
IA_MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   (para IA_PROVEEDOR=claude, IA_MODELO=claude-haiku-5-5)

# ---- Negocio ----
NEGOCIO=Barü Bio
# Cómo se nombra a la persona que atiende tras el bot.
ASESOR=su asesor personal
# Horario de atención humana (los admins lo pueden cambiar con /horario).
HORARIO=lun-vie 09:00-12:00 15:00-19:00
ZONA_HORARIA=America/Panama

# Precios compartidos (misma URL que usa el generador de protocolos).
PRECIOS_URL=

# Clave para que alguien se registre como admin enviando: /admin CLAVE
CLAVE_ADMIN=

# Carpeta donde se guardan conversaciones y clientes (solo en este equipo).
DATOS_DIR=./datos

# Secreto con el que Telegram firma los mensajes que entrega a la nube (cualquier texto largo al azar).
WEBHOOK_SECRETO=
# URL del bot en Cloudflare (aparece al publicar con npm run nube:publicar).
NUBE_URL=

# Clave con la que el bot anota clientes en la hoja (la misma que la propiedad CLAVE_BOT del Apps Script).
HOJA_CLAVE_BOT=
